. .husky/step.sh

step lockfile '🧶 pnpm-lock.yaml desactualizado: ejecuta "pnpm install".' pnpm install --frozen-lockfile
step dedupe '👯 Dependencias duplicadas: ejecuta "pnpm dedupe".' pnpm dedupe --check
step format '🤢 Ejecuta "pnpm format" y añade los cambios.' pnpm format-check
step lint '😤 Corrige lo indicado arriba.' pnpm lint
step type-check '🤓 Corrige los errores de tipos.' pnpm type-check