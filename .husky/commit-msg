#!/usr/bin/env sh

# Git hooks no cargan tu shell — usar Node del proyecto (mise), no el Node 20 del sistema
export PATH="$HOME/.local/share/mise/shims:$PATH"

commit_msg_file="$1"
root_dir="$(cd "$(dirname "$0")/.." && pwd)"

# Sin trailers («Clave: valor» al final del mensaje)
if [ -n "$(git interpret-trailers --parse "$commit_msg_file")" ]; then
  echo '🚫 Commit rejected: trailers are not allowed in commit messages.'
  exit 1
fi

"$root_dir/node_modules/.bin/commitlint" --edit "$commit_msg_file" || exit 1
